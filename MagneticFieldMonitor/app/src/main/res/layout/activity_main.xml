<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/background"
        android:clipToPadding="false">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        style="@style/Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lab_title"/>
    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lab_subtitle"
        android:textColor="@color/secondary"/>
    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/description"/>
    <TextView
        android:id="@+id/sensor_info"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
</LinearLayout><Space android:layout_width="1dp" android:layout_height="20dp"/><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel">
    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reading_title"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/values_empty"
        android:textSize="25sp"
        android:textColor="@color/text"
        android:fontFamily="monospace"/>
    <TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/formula"/>
    <TextView
        android:id="@+id/status"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/waiting"/>
    <TextView
        android:id="@+id/accuracy"
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout><Space android:layout_width="1dp" android:layout_height="16dp"/><Button
        android:id="@+id/toggle"
        style="@style/Action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stop"/>
<Button
        android:id="@+id/sensors"
        style="@style/Action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/all_sensors"/>
<Button
        android:id="@+id/about"
        style="@style/Action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about"/>
<TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/axes"/>
<TextView
        style="@style/Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/calibration"/></LinearLayout></ScrollView>
